# AULA F75 running this firmware: let the logged-in user talk to the keyboard
# over hidraw (Vial in the browser or desktop app, and sinowisp).
#
# Install:
#   sudo cp 70-aula-f75-vial.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# then unplug and replug the keyboard.

# Normal mode ("SMK Keyboard")
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", TAG+="uaccess"
# ISP bootloader mode (used while flashing)
KERNEL=="hidraw*", ATTRS{idVendor}=="0603", ATTRS{idProduct}=="1020", TAG+="uaccess"
